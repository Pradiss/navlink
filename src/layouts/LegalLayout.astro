---
import Layout from './Layout.astro';
import Footer from '../components/sections/Footer.astro';
import { Image } from 'astro:assets';
import logo from '../assets/logos/logo.webp';

interface Props {
	title: string;
	description?: string;
	updatedAt?: string;
}

const { title, description, updatedAt = 'janeiro de 2026' } = Astro.props;
---

<Layout title={`${title} | NaveLinkNet`} description={description}>
	<header class="bg-[#0a1657]">
		<div class="mx-auto flex max-w-[900px] items-center justify-between px-4 py-5 sm:px-6">
			<a href="/" class="flex items-center">
				<Image src={logo} alt="NaveLinkNet" class="h-8 w-auto sm:h-9" />
			</a>

			<a
				href="/"
				class="text-xs font-semibold text-blue-100 transition hover:text-white sm:text-sm"
			>
				&larr; Voltar ao site
			</a>
		</div>
	</header>

	<main class="mx-auto max-w-[900px] px-4 py-10 sm:px-6 sm:py-14">
		<h1 class="text-2xl font-black tracking-tight text-[#0a1657] sm:text-4xl">
			{title}
		</h1>
		<p class="mt-2 text-sm text-slate-500">Última atualização: {updatedAt}</p>

		<div class="mt-8 space-y-6 text-[15px] leading-relaxed text-slate-700 [&_a]:font-semibold [&_a]:text-sky-600 [&_a]:underline [&_h2]:mt-10 [&_h2]:text-xl [&_h2]:font-black [&_h2]:text-[#0a1657] [&_h2]:first:mt-0 [&_li]:mt-1 [&_ul]:list-disc [&_ul]:pl-5">
			<slot />
		</div>
	</main>

	<Footer />
</Layout>
