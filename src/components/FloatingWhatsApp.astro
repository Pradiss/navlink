---
import { Icon } from 'astro-icon/components';

const whatsappNumber = '5519989007767';
---

<a
	href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Olá, gostaria de contratar um plano. Vim do Google.')}`}
	target="_blank"
	rel="noopener noreferrer"
	aria-label="Falar no WhatsApp"
	class="fixed right-4 bottom-4 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-green-500 text-white shadow-lg shadow-black/30 transition hover:brightness-110 sm:hidden"
>
	<Icon name="simple-icons:whatsapp" class="h-7 w-7" />
</a>
