---
const whatsappNumber = '5500000000000';

const plans = [
	{
		name: 'COMBO START',
		speed: '300',
		unit: 'MEGA',
		features: ['Wi-Fi incluso', '2 apps de streaming', 'Ideal para o dia a dia'],
		price: '79,90',
		highlighted: false,
	},
	{
		name: 'COMBO FULL',
		speed: '850',
		unit: 'MEGA',
		features: ['Wi-Fi incluso', '3 apps de streaming', 'Ideal para famílias'],
		price: '139,80',
		highlighted: true,
		badge: 'MAIS ESCOLHIDO',
	},
	{
		name: 'COMBO VIP',
		speed: '1',
		unit: 'GIGA',
		features: ['Wi-Fi incluso', '4 apps de streaming', 'Máxima performance'],
		price: '169,90',
		highlighted: false,
	},
];
---

<section class="bg-[#0a1657] px-6 pb-14">
	<div class="mx-auto grid max-w-6xl gap-6 sm:grid-cols-3">
		{
			plans.map((plan) => (
				<div
					class:list={[
						'relative flex flex-col rounded-2xl border p-6',
						plan.highlighted
							? 'border-cyan-300 bg-[#0d1c6e] shadow-[0_0_40px_rgba(34,211,238,0.35)]'
							: 'border-white/15 bg-white/5',
					]}
				>
					{plan.badge && (
						<span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-cyan-400 px-4 py-1 text-xs font-bold whitespace-nowrap text-[#0a1657]">
							👑 {plan.badge}
						</span>
					)}

					<p class="text-center text-sm font-bold tracking-wide text-cyan-300">{plan.name}</p>

					<p class="mt-2 text-center text-5xl font-black text-white">{plan.speed}</p>
					<p class="text-center text-sm font-bold tracking-widest text-white">{plan.unit}</p>

					<ul class="mt-6 space-y-3 text-sm text-blue-100">
						{plan.features.map((feature) => (
							<li class="flex items-center gap-2">
								<svg viewBox="0 0 24 24" fill="none" class="h-4 w-4 shrink-0 text-cyan-300" stroke="currentColor" stroke-width="2" stroke-linecap="round">
									<path d="M4 9a12 12 0 0 1 16 0" />
									<path d="M7 13a7.5 7.5 0 0 1 10 0" />
									<circle cx="12" cy="18" r="1.4" fill="currentColor" stroke="none" />
								</svg>
								{feature}
							</li>
						))}
					</ul>

					<p class="mt-6 text-white">
						<span class="text-sm align-top">R$</span>
						<span class="text-4xl font-black">{plan.price.split(',')[0]}</span>
						<span class="text-lg font-bold">,{plan.price.split(',')[1]}</span>
						<span class="text-sm text-blue-200">/mês</span>
					</p>

					<a
						href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`Olá! Tenho interesse no ${plan.name}.`)}`}
						target="_blank"
						rel="noopener noreferrer"
						class="mt-6 flex items-center justify-center gap-2 rounded-full bg-green-500 py-3 text-sm font-bold text-white transition hover:bg-green-400"
					>
						<svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
							<path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.39 1.26 4.81L2 22l5.42-1.34a9.86 9.86 0 0 0 4.62 1.14h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2zm5.79 14.02c-.24.68-1.4 1.32-1.93 1.4-.5.08-1.13.11-1.82-.11-.42-.13-.96-.31-1.65-.6-2.9-1.25-4.79-4.17-4.94-4.36-.14-.19-1.18-1.57-1.18-3 0-1.42.75-2.12 1.02-2.41.27-.29.58-.36.78-.36h.55c.18 0 .42-.03.65.5.24.55.81 1.9.88 2.03.07.14.12.3.02.49-.1.19-.15.3-.29.46-.14.16-.3.36-.43.48-.14.13-.29.28-.13.55.17.28.75 1.24 1.61 2 1.11.99 2.04 1.3 2.32 1.44.27.14.43.12.6-.07.16-.19.7-.81.89-1.09.19-.28.37-.23.62-.14.25.09 1.6.75 1.87.89.27.14.45.2.52.32.07.11.07.66-.17 1.34z" />
						</svg>
						QUERO ESTE PLANO
					</a>
				</div>
			))
		}
	</div>
</section>
