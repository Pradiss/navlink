---
const whatsappNumber = '5500000000000';
---

<section class="bg-[#0a1657] px-6 pb-10">
	<div class="mx-auto grid max-w-6xl grid-cols-3 gap-4 border-t border-white/10 pt-8 text-center">
		<div class="flex flex-col items-center gap-3 sm:flex-row sm:text-left">
			<svg viewBox="0 0 24 24" fill="none" class="h-8 w-8 shrink-0 text-cyan-300" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
				<path d="M14.7 6.3 17.7 3.3M9.3 11.7 3.3 17.7" />
				<path d="m8 12 4-4 3 3-4 4z" />
				<path d="M6.5 17.5 3 21l3.5-3.5z" />
			</svg>
			<span class="text-xs font-semibold text-white sm:text-sm">Instalação<br class="sm:hidden" /> grátis</span>
		</div>

		<div class="flex flex-col items-center gap-3 sm:flex-row sm:text-left">
			<svg viewBox="0 0 24 24" fill="none" class="h-8 w-8 shrink-0 text-cyan-300" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
				<circle cx="12" cy="13" r="8" />
				<path d="M12 13 15 9M9 13a1 1 0 1 0 0 1" />
				<path d="M12 3v2M4 6l1.5 1.5M20 6l-1.5 1.5" />
			</svg>
			<span class="text-xs font-semibold text-white sm:text-sm">Teste de<br class="sm:hidden" /> velocidade<br class="sm:hidden" /> na instalação</span>
		</div>

		<div class="flex flex-col items-center gap-3 sm:flex-row sm:text-left">
			<svg viewBox="0 0 24 24" fill="none" class="h-8 w-8 shrink-0 text-cyan-300" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
				<path d="M4 13a8 8 0 0 1 16 0" />
				<rect x="3" y="13" width="4" height="6" rx="1.5" />
				<rect x="17" y="13" width="4" height="6" rx="1.5" />
				<path d="M19 19v1a2 2 0 0 1-2 2h-3" />
			</svg>
			<span class="text-xs font-semibold text-white sm:text-sm">Suporte<br class="sm:hidden" /> técnico<br class="sm:hidden" /> próprio</span>
		</div>
	</div>

	<div class="mx-auto mt-10 max-w-6xl">
		<a
			href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Olá! Quero contratar um plano NaveLinkNet.')}`}
			target="_blank"
			rel="noopener noreferrer"
			class="flex items-center justify-center gap-3 rounded-full bg-green-500 py-5 text-lg font-extrabold text-white transition hover:bg-green-400"
		>
			<svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6">
				<path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.39 1.26 4.81L2 22l5.42-1.34a9.86 9.86 0 0 0 4.62 1.14h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2zm5.79 14.02c-.24.68-1.4 1.32-1.93 1.4-.5.08-1.13.11-1.82-.11-.42-.13-.96-.31-1.65-.6-2.9-1.25-4.79-4.17-4.94-4.36-.14-.19-1.18-1.57-1.18-3 0-1.42.75-2.12 1.02-2.41.27-.29.58-.36.78-.36h.55c.18 0 .42-.03.65.5.24.55.81 1.9.88 2.03.07.14.12.3.02.49-.1.19-.15.3-.29.46-.14.16-.3.36-.43.48-.14.13-.29.28-.13.55.17.28.75 1.24 1.61 2 1.11.99 2.04 1.3 2.32 1.44.27.14.43.12.6-.07.16-.19.7-.81.89-1.09.19-.28.37-.23.62-.14.25.09 1.6.75 1.87.89.27.14.45.2.52.32.07.11.07.66-.17 1.34z" />
			</svg>
			CONTRATE PELO WHATSAPP
			<svg viewBox="0 0 24 24" fill="none" class="h-5 w-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
				<path d="M9 6l6 6-6 6" />
			</svg>
		</a>

		<p class="mt-6 flex items-center justify-center gap-2 pb-10 text-sm text-blue-200">
			<svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
				<path d="M12 1a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2h-1V6a5 5 0 0 0-5-5zm-3 8V6a3 3 0 0 1 6 0v3z" />
			</svg>
			Seus dados estão seguros conosco.
		</p>
	</div>
</section>
