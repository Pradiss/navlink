---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import logo from '../../assets/logos/logo.png';
---

<header class="relative z-20">
	<div class="mx-auto flex max-w-6xl items-center justify-between px-3 py-6 lg:px-8 lg:py-8">
		<a href="/" class="flex items-center">
			<Image src={logo} alt="NaveLinkNet" class="h-8 w-auto sm:h-9 lg:h-10" />
		</a>

		<button
			type="button"
			aria-label="Abrir menu"
			class="flex h-10 w-10 items-center justify-center rounded-lg text-white hover:bg-white/10 lg:h-11 lg:w-11"
		>
			<Icon name="lucide:menu" class="h-6 w-6 lg:h-7 lg:w-7" />
		</button>
	</div>
</header>
