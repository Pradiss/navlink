---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import faixada from '../../assets/faixada.webp';

const cities =
	'Limeira, Mogi Mirim, Mogi Guaçu, Iracemápolis, Santo Antônio de Posse, Conchal, Estiva Gerbi e Martinho Prado.';

const stats = [
	{
		label: 'Atendimento\npróximo e humanizado',
		icon: 'lucide:users-round',
	},
	{
		label: 'Qualidade\nnos serviços',
		icon: 'lucide:badge-check',
	},
	{
		label: 'Presente em\ndiversas cidades da região',
		icon: 'lucide:map-pin',
	},
	{
		label: 'Conectando mais pessoas\ntodos os dias',
		icon: 'lucide:wifi',
	},
];
---

<section class="relative isolate overflow-hidden">

	<!-- ================= FOTO DE FUNDO ================= -->
	<div class="absolute inset-0 -z-20">
		<Image
			src={faixada}
			alt="Fachada da NaveLinkNet"
			class="h-full w-full object-cover"
			widths={[800, 1200, 1600, 1920]}
			sizes="100vw"
		/>
	</div>

	<!-- overlay escuro pra legibilidade do texto -->
	<div
		class="absolute inset-0 -z-10 bg-gradient-to-r from-[#09265f]/95 via-[#09265f]/80 to-[#09265f]/30"
	></div>

	<!-- brilho decorativo -->
	<div class="pointer-events-none absolute inset-0 -z-10">
		<div class="absolute top-0 right-0 h-[650px] w-[650px] rounded-full bg-sky-400/10 blur-3xl"></div>
	</div>

	<div class="relative mx-auto max-w-[1200px] px-6 py-10 sm:px-10 lg:px-12">

		<!-- ================= HEADER ================= -->
		<header class="flex items-center gap-5">

			<!-- LOGO -->
			<div class="flex items-center gap-3">

				<div
					class="flex h-12 w-12 items-center justify-center rounded-xl bg-sky-500 shadow-sm"
				>
					<Icon
						name="lucide:wifi"
						class="h-7 w-7 text-white"
						strokeWidth={2.5}
					/>
				</div>

				<div
					class="text-[26px] font-extrabold tracking-[-0.06em] text-white"
				>
					nave<span class="text-sky-400">link</span>net
					<sup class="ml-0.5 text-[9px] align-top">®</sup>
				</div>

			</div>

			<!-- DIVISÓRIA -->
			<div class="h-12 w-px bg-white/25"></div>

			<!-- 10 ANOS -->
			<div class="flex items-center gap-1">

				<span
					class="text-[58px] leading-none font-black tracking-[-0.08em] text-sky-400"
				>
					10
				</span>

				<span
					class="text-[10px] font-bold leading-tight text-white uppercase"
				>
					anos
				</span>

			</div>

		</header>


		<!-- ================= CONTEÚDO ================= -->
		<div class="relative mt-10 max-w-[560px]">

			<div
				class="inline-flex rounded-full bg-white/10 px-5 py-2 backdrop-blur-sm"
			>
				<span
					class="text-[14px] font-extrabold tracking-wide text-white uppercase"
				>
					Quem somos
				</span>
			</div>


			<h2
				class="mt-5 text-[48px] leading-[0.94] font-black tracking-[-0.045em] text-white sm:text-[58px]"
			>
				Conectando<br />
				pessoas desde
			</h2>

			<div
				class="mt-1 text-[76px] leading-none font-black tracking-[-0.06em] text-sky-400 sm:text-[88px]"
			>
				2014
			</div>


			<p
				class="mt-7 max-w-[470px] text-[17px] leading-[1.45] text-sky-50/90"
			>
				Nascemos com a missão de conectar pessoas e levar mais
				entretenimento, informação e qualidade de vida para os nossos
				clientes.
			</p>


			<p
				class="mt-5 max-w-[470px] text-[17px] leading-[1.45] text-sky-50/90"
			>
				Estamos presentes em {cities}
			</p>


			<p
				class="mt-5 max-w-[470px] text-[17px] leading-[1.45] text-sky-50/90"
			>
				Somos referência em qualidade nos serviços e atendimento.
			</p>

		</div>


		<!-- ================= CARDS ================= -->
		<div
			class="relative z-30 mt-12 rounded-[32px] border border-white/10 bg-white/95 px-5 py-7 shadow-[0_15px_50px_rgba(8,60,120,0.25)] backdrop-blur-sm sm:px-8"
		>

			<div class="grid grid-cols-2 lg:grid-cols-4">

				{
					stats.map((stat, index) => (
						<div
							class:list={[
								'flex flex-col items-center justify-center px-5 text-center',
								index !== 0 && 'border-l border-slate-200',
								index >= 2 && 'mt-7 border-l-0 sm:mt-0 lg:border-l',
							]}
						>

							<div
								class="flex h-[72px] w-[72px] items-center justify-center rounded-full bg-sky-100"
							>
								<Icon
									name={stat.icon}
									class="h-8 w-8 text-sky-600"
									strokeWidth={2}
								/>
							</div>

							<p
								class="mt-4 whitespace-pre-line text-[15px] font-medium leading-[1.25] text-[#24385d]"
							>
								{stat.label}
							</p>

						</div>
					))
				}

			</div>

		</div>


		<!-- ================= FRASE FINAL ================= -->
		<div class="relative mt-10 pb-12 text-center">

			<p
				class="text-[15px] font-medium tracking-[0.28em] text-white uppercase"
			>
				Mais que internet,
			</p>

			<p
				class="mt-1 text-[17px] font-semibold tracking-[0.22em] text-white uppercase"
			>
				Mais conexões para a
				<span class="font-black text-sky-400">
					sua vida
				</span>
			</p>


			<!-- assinatura -->
			<svg
				viewBox="0 0 180 45"
				class="mx-auto mt-3 h-10 w-36 text-sky-400"
				fill="none"
			>
				<path
					d="M8 31 C40 40 70 35 91 22 C111 10 134 10 169 7"
					stroke="currentColor"
					stroke-width="3"
					stroke-linecap="round"
				/>

				<path
					d="M91 22 C102 20 110 15 117 10"
					stroke="currentColor"
					stroke-width="3"
					stroke-linecap="round"
				/>
			</svg>

		</div>

	</div>

</section>