---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import faixada from '../../assets/faixada.webp';
import logo from '../../assets/logos/logo.webp';
import design from '../../assets/design.webp';
import anos from '../../assets/10anos.webp';

const cities =
	'Limeira, Mogi Mirim, Mogi Guaçu, Iracemápolis, Santo Antônio de Posse, Conchal, Estiva Gerbi e Martinho Prado.';

const stats = [
	{
		label: 'Atendimento\npróximo e humanizado',
		icon: 'lucide:users-round',
	},
	{
		label: 'Qualidade\nnos serviços',
		icon: 'lucide:badge-check',
	},
	{
		label: 'Presente em\ndiversas cidades da região',
		icon: 'lucide:map-pin',
	},
	{
		label: 'Conectando mais pessoas\ntodos os dias',
		icon: 'lucide:wifi',
	},
];
---

<section class="relative overflow-hidden bg-gradient-to-b from-sky-50 via-white to-white px-4 py-10 sm:px-6 sm:py-14 lg:px-10 lg:py-20">
	<!-- brilho decorativo -->
	<div class="pointer-events-none absolute inset-0">
		<div class="absolute top-0 right-0 h-[300px] w-[300px] rounded-full bg-sky-300/20 blur-3xl sm:h-[450px] sm:w-[450px]"></div>
	</div>

	<div class="relative mx-auto max-w-[1250px]">
		<!-- ================= HEADER ================= -->
		<header class="flex items-center gap-3 sm:gap-5">
			<!-- LOGO -->
			<div class="flex items-center rounded-xl bg-[#0a1657] px-3 py-2 shadow-sm sm:px-4 sm:py-2.5 lg:px-5 lg:py-3">
				<Image src={logo} alt="NaveLinkNet" class="h-6 w-auto sm:h-8 lg:h-9" />
			</div>

			<!-- DIVISÓRIA -->
			<div class="h-9 w-px bg-slate-200 sm:h-12 lg:h-14"></div>

			<!-- 10 ANOS -->
			<div class="flex items-center gap-1">
				<Image
					src={anos}
					alt="10 anos"
					class="h-10 w-auto object-contain sm:h-16 lg:h-20"
					widths={[200, 400]}
					sizes="200px"
				/>
			</div>
		</header>

		<!-- ================= CONTEÚDO: TEXTO + FOTO ================= -->

		<div class="relative mt-8 sm:mt-10 lg:mt-12">
			<!-- ===== MOBILE / TABLET: FOTO COMO BACKGROUND ===== -->
			<div class="relative isolate overflow-hidden rounded-3xl lg:hidden">
				<!-- FOTO DE FUNDO -->
				<div class="absolute inset-0 -z-10">
					<Image
						src={faixada}
						alt="Fachada da NaveLinkNet"
						class="h-full w-full object-[center_30%] sm:object-[center_40%]"
						widths={[500, 800, 1100]}
						sizes="100vw"
					/>
				</div>

				<!-- OVERLAY pra legibilidade do texto -->
				<div class="absolute inset-0 -z-10 bg-gradient-to-r from-white via-white/85 to-white/20 sm:from-white sm:via-white/80 sm:to-transparent"></div>

				<!-- TEXTO -->
				<div class="relative z-10 px-4 py-8 sm:px-8 sm:py-12">
					<span class="inline-block rounded-full bg-sky-200 px-3 py-1 text-[10px] font-bold text-sky-700 uppercase sm:px-4 sm:py-1.5 sm:text-xs">
						Quem somos
					</span>

					<h2 class="mt-3 max-w-[75%] text-2xl leading-[1.05] font-black tracking-[-0.03em] text-[#0a1657] sm:mt-5 sm:max-w-[65%] sm:text-[42px] sm:leading-[0.94]">
						Conectando
						<br />
						pessoas desde
					</h2>

					<div class="mt-1 text-4xl leading-none font-black tracking-[-0.04em] text-sky-500 sm:text-[64px]">
						2014
					</div>

					<p class="mt-4 max-w-[75%] text-[11px] leading-[1.4] text-slate-700 sm:mt-6 sm:max-w-[65%] sm:text-[15px] sm:leading-[1.45]">
						Nascemos com a missão de conectar pessoas e levar mais
						entretenimento, informação e qualidade de vida para os nossos
						clientes.
					</p>

					<p class="mt-3 max-w-[75%] text-[11px] leading-[1.4] text-slate-700 sm:mt-4 sm:max-w-[65%] sm:text-[15px] sm:leading-[1.45]">
						Estamos presentes em {cities}
					</p>

					<p class="mt-3 max-w-[75%] text-[11px] leading-[1.4] text-slate-700 sm:mt-4 sm:max-w-[65%] sm:text-[15px] sm:leading-[1.45]">
						Somos referência em qualidade nos serviços e atendimento.
					</p>
				</div>
			</div>

			<!-- ===== DESKTOP: LADO A LADO ===== -->
			<div class="hidden lg:block lg:min-h-[560px]">
				<div class="relative z-30 w-[48%]">
					<span class="inline-block rounded-full bg-sky-200 px-4 py-1.5 text-xs font-bold text-sky-700 uppercase">
						Quem somos
					</span>

					<h2 class="mt-5 text-[54px] leading-[0.94] font-black tracking-[-0.03em] text-[#0a1657]">
						Conectando
						<br />
						pessoas desde
					</h2>

					<div class="mt-1 text-[84px] leading-none font-black tracking-[-0.04em] text-sky-500">
						2014
					</div>

					<p class="mt-7 max-w-[470px] text-[17px] leading-[1.45] text-slate-600">
						Nascemos com a missão de conectar pessoas e levar mais
						entretenimento, informação e qualidade de vida para os nossos
						clientes.
					</p>

					<p class="mt-4 max-w-[470px] text-[17px] leading-[1.45] text-slate-600">
						Estamos presentes em {cities}
					</p>

					<p class="mt-4 max-w-[470px] text-[17px] leading-[1.45] text-slate-600">
						Somos referência em qualidade nos serviços e atendimento.
					</p>
				</div>

				<div class="pointer-events-none absolute right-0 top-[20px] z-20 h-[520px] w-[48%]">
					<div class="pointer-events-none absolute -inset-5 -z-10 rounded-full bg-sky-300/25 blur-3xl"></div>

					<div class="h-full w-full overflow-hidden rounded-3xl">
						<Image
							src={faixada}
							alt="Fachada da NaveLinkNet"
							class="h-full w-full"
							widths={[600, 900, 1200]}
							sizes="560px"
						/>
					</div>
				</div>
			</div>
		</div>

		<!-- ================= CARDS ================= -->
		<div class="relative z-30 mt-10 rounded-[24px] border border-sky-100 bg-white py-6 shadow-[0_15px_50px_rgba(8,60,120,0.1)] sm:mt-12 sm:rounded-[32px] sm:px-8 sm:py-7 lg:mt-16 lg:px-10 lg:py-9">
			<div class="grid grid-cols-4 divide-x divide-slate-200">
				{stats.map((stat) => (
					<div class="flex flex-col items-center justify-center px-1.5 text-center sm:px-5">
						<div class="flex h-11 w-11 items-center justify-center rounded-full bg-sky-100 sm:h-[72px] sm:w-[72px] lg:h-20 lg:w-20">
							<Icon
								name={stat.icon}
								class="h-5 w-5 text-sky-600 sm:h-8 sm:w-8 lg:h-9 lg:w-9"
								strokeWidth={2}
							/>
						</div>

						<p class="mt-2 whitespace-pre-line text-[9px] font-medium leading-[1.3] text-[#24385d] sm:mt-4 sm:text-[15px] sm:leading-[1.25] lg:text-[16px]">
							{stat.label}
						</p>
					</div>
				))}
			</div>
		</div>

		<!-- ================= FRASE FINAL ================= -->
		<div class="relative mt-8 text-center sm:mt-10 lg:mt-14">
			<p class="text-[11px] font-medium tracking-[0.2em] text-[#0a1657] uppercase sm:text-[15px] sm:tracking-[0.28em] lg:text-[17px]">
				Mais que internet,
			</p>

			<p class="mt-1 text-xs font-semibold tracking-[0.15em] text-[#0a1657] uppercase sm:text-[17px] sm:tracking-[0.22em] lg:text-[20px]">
				Mais conexões para a
				<span class="font-black text-sky-500"> sua vida</span>
			</p>

			<!-- assinatura -->

			<Image
				src={design}
				alt=""
				class="mx-auto mt-2 h-8 w-auto object-contain sm:mt-3 sm:h-10"
				widths={[150, 300]}
				sizes="150px"
			/>
		</div>
	</div>
</section>
