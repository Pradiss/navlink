---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import Header from './Header.astro';
import PlanCards from './PlanCards.astro';

import astronaut from '../../assets/astronauta.webp';
import disneyLogo from '../../assets/logos/logo disney.webp';
import maxLogo from '../../assets/logos/logomax.webp';

const featureStrip = [
	{
		icon: 'lucide:wrench',
		title: 'Instalação',
		text: 'grátis',
	},
	{
		icon: 'lucide:gauge',
		title: 'Teste de velocidade',
		text: 'na instalação',
	},
	{
		icon: 'lucide:headphones',
		title: 'Suporte técnico',
		text: 'próprio',
	},
];
---

<section class="relative isolate overflow-hidden bg-[#062b83] text-white">
	<!-- FUNDO -->
	<div class="pointer-events-none absolute inset-0 overflow-hidden">
		<div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_30%,#087de0_0%,#0750b8_32%,#062b83_68%,#031e67_100%)]"></div>

		<div class="absolute right-[5%] top-[8%] h-[550px] w-[550px] rounded-full bg-cyan-400/20 blur-[110px]"></div>

		<div class="absolute -left-40 top-[30%] h-[400px] w-[400px] rounded-full bg-blue-400/10 blur-[100px]"></div>

		<!-- linhas de luz -->
		<div class="absolute right-[-150px] top-[30%] h-[2px] w-[650px] rotate-[-19deg] bg-cyan-300/30"></div>
		<div class="absolute right-[-130px] top-[37%] h-[1px] w-[600px] rotate-[-19deg] bg-cyan-200/20"></div>
		<div class="absolute right-[-170px] top-[44%] h-[2px] w-[700px] rotate-[-19deg] bg-cyan-300/15"></div>
	</div>

	<!-- HEADER -->
	<div class="relative z-50">
		<Header />
	</div>

	<!-- CONTAINER -->
	<div class="relative mx-auto max-w-[1250px] px-3 sm:px-8 lg:px-10">
		<!-- ==================================================
		     HERO
		================================================== -->

		<div
			class="relative
				min-h-[300px]
				sm:min-h-[700px]
				lg:min-h-[650px]"
		>
			<!-- ==================================================
			     TEXTO PRINCIPAL
			================================================== -->

			<div
				class="relative
					z-30
					w-[62%]
					pt-8
					sm:w-[58%]
					sm:pt-12
					lg:w-[55%]
					lg:pt-14"
			>
				<p
					class="text-[8px]
						font-medium
						tracking-[0.25em]
						text-cyan-100
						uppercase
						sm:text-[13px]
						lg:text-[14px]"
				>
					Internet que te conecta mais
				</p>

				<h1
					class="mt-1
						text-[36px]
						leading-[0.88]
						font-black
						
						sm:text-[58px]
						lg:text-[70px]
						xl:text-[78px]"
				>
					<span class="block text-white">INTERNET</span>
				</h1>
				<h1
					class="text-[22px]
						leading-[0.88]
						font-black
						
						sm:text-[58px]
						lg:text-[70px]
						xl:text-[78px]"
				>
					<span class="block text-cyan-300">NA VELOCIDADE</span>
				</h1>

				<h1
					class="text-[36px]
						leading-[0.88]
						font-black
						
						sm:text-[58px]
						lg:text-[70px]
						xl:text-[78px]"
				>
					<span class="block text-white">DA LUZ!</span>
				</h1>

				<p
					class="mt-4
						max-w-[310px]
						text-[14px]
						leading-[1.35]
						text-blue-50
						sm:max-w-[400px]
						sm:text-[18px]
						lg:text-[19px]
						xl:max-w-[440px]
						xl:text-[20px]"
				>
					Planos com
					<strong class="font-extrabold text-white"> Disney+</strong>,
					<strong class="font-extrabold text-white"> MAX</strong> <br />
					e muito mais para você <br /> e sua família.
				</p>

				<!-- LOGOS -->
				<div
					class="mt-5
						flex
						items-center
						gap-4
						sm:mt-7
						sm:gap-8
						lg:gap-10"
				>
					<Image
						src={disneyLogo}
						alt="Disney+"
						class="h-9 w-auto object-contain sm:h-10 lg:h-15"
					/>

					<div class="h-8 w-px bg-white/30 sm:h-12"></div>

					<Image
						src={maxLogo}
						alt="MAX"
						class="h-9 w-auto object-contain brightness-0 invert sm:h-8 lg:h-13"
					/>
				</div>
			</div>

			<!-- ==================================================
			     ASTRONAUTA
			================================================== -->

			<div
				class="pointer-events-none
		absolute
		right-[-9%]
		top-[20px]
		z-20
		h-[280px]
		w-[250px]
		sm:right-[-12%]
		sm:top-[115px]
		sm:h-[560px]
		sm:w-[590px]
		lg:right-[-7%]
		lg:top-[45px]
		lg:h-[680px]
		lg:w-[720px]
		xl:h-[760px]
		xl:w-[800px]"
			>
				<!-- BRILHO ATRÁS DO ASTRONAUTA -->
				<div
					class="absolute
			left-[15%]
			top-[12%]
			h-[180px]
			w-[180px]
			rounded-full
			bg-cyan-300/20
			blur-[80px]
			sm:h-[350px]
			sm:w-[350px]"
				></div>

				<Image
					src={astronaut}
					alt="Astronauta NaveLinkNet"
					class="relative
			h-full
			w-full
			object-contain
			object-bottom
			
			[mask-image:linear-gradient(to_bottom,black_94%,transparent_100%)]
			[-webkit-mask-image:linear-gradient(to_bottom,black_94%,transparent_100%)]"
					widths={[500, 700, 900]}
					sizes="(min-width: 1024px) 720px, 65vw"
				/>
			</div>

			<!-- ==================================================
			     FRASE AO LADO DO ASTRONAUTA
			================================================== -->

			<div
				class="absolute
					right-[0%]
					top-[0px]
					z-30
					rotate-[-15deg]
		
					lg:right-[2%]"
			>
				<p
					class="font-serif
						text-[12px]
						leading-[1.3]
						text-white
						italic
						sm:text-[19px]
						lg:text-[21px]"
				>
					Conectar
					<br />
					pessoas
					<br />
					é o que
					<br />
					nos move!
				</p>
			</div>
		</div>

		<PlanCards />

		<!-- ==================================================
		     BENEFÍCIOS
		================================================== -->

		<div
			class="relative
				z-30
				py-4
				sm:py-10
				lg:py-12"
		>
			<div class="grid grid-cols-3">
				{featureStrip.map((item, index) => (
					<div
						class:list={[
							'flex flex-col items-center justify-center gap-1 px-1 text-center',
							index > 0 && 'border-l border-cyan-300/30',
							'sm:flex-row sm:gap-3 sm:text-left',
						]}
					>
						<Icon
							name={item.icon}
							class="h-7
									w-7
									shrink-0
									text-cyan-300
									sm:h-9
									sm:w-9
									lg:h-10
									lg:w-10"
						/>

						<div class="leading-tight">
							<p
								class="text-[8px]
										font-medium
										text-white/90
										sm:text-[15px]
										lg:text-[16px]"
							>
								{item.title}
							</p>

							<p
								class="text-[8px]
										text-white/90
										sm:text-[15px]
										lg:text-[16px]"
							>
								{item.text}
							</p>
						</div>
					</div>
				))}
			</div>
		</div>

		<!-- SEGURANÇA -->
		<p
			class="relative
				z-30
				flex
				items-center
				justify-center
				gap-1.5
				pb-7
				text-[10px]
				text-white/80
				sm:gap-2
				sm:pb-8
				sm:text-[13px]"
		>
			<Icon name="lucide:lock-keyhole" class="h-3.5 w-3.5 sm:h-4 sm:w-4" />
			Seus dados estão seguros conosco.
		</p>
	</div>
</section>

<style>
	.card-glow {
		box-shadow:
			0 0 10px rgba(0, 220, 255, 0.75),
			0 0 18px rgba(0, 220, 255, 0.55),
			0 10px 30px rgba(0, 0, 0, 0.25);
	}
</style>
