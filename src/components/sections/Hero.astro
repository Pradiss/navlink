---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import Header from './Header.astro';

import astronaut from '../../assets/astronauta.webp';
import disneyLogo from '../../assets/logos/logo disney.webp';
import maxLogo from '../../assets/logos/logomax.png';

const whatsappNumber = '5500000000000';

const plans = [
	{
		name: 'COMBO START',
		speed: '300',
		unit: 'MEGA',
		features: [
			{ icon: 'lucide:wifi', label: 'Wi-Fi incluso' },
			{ icon: 'lucide:monitor-play', label: '2 apps de streaming' },
			{ icon: 'lucide:users-round', label: 'Ideal para o dia a dia' },
		],
		price: '79,90',
	},
	{
		name: 'COMBO FULL',
		speed: '850',
		unit: 'MEGA',
		features: [
			{ icon: 'lucide:wifi', label: 'Wi-Fi incluso' },
			{ icon: 'lucide:monitor-play', label: '3 apps de streaming' },
			{ icon: 'lucide:users-round', label: 'Ideal para famílias' },
		],
		price: '139,80',
		highlighted: true,
	},
	{
		name: 'COMBO VIP',
		speed: '1 GIGA',
		unit: '',
		features: [
			{ icon: 'lucide:wifi', label: 'Wi-Fi incluso' },
			{ icon: 'lucide:monitor-play', label: '4 apps de streaming' },
			{ icon: 'lucide:users-round', label: 'Máxima performance' },
		],
		price: '169,90',
	},
];

const featureStrip = [
	{
		icon: 'lucide:wrench',
		title: 'Instalação',
		text: 'grátis',
	},
	{
		icon: 'lucide:gauge',
		title: 'Teste de velocidade',
		text: 'na instalação',
	},
	{
		icon: 'lucide:headphones',
		title: 'Suporte técnico',
		text: 'próprio',
	},
];
---

<section class="relative isolate overflow-hidden bg-[#062b83] text-white">

	<!-- FUNDO -->
	<div class="pointer-events-none absolute inset-0 overflow-hidden">

		<div
			class="absolute inset-0 bg-[radial-gradient(circle_at_70%_30%,#087de0_0%,#0750b8_32%,#062b83_68%,#031e67_100%)]"
		></div>

		<div
			class="absolute right-[5%] top-[8%] h-[550px] w-[550px] rounded-full bg-cyan-400/20 blur-[110px]"
		></div>

		<div
			class="absolute -left-40 top-[30%] h-[400px] w-[400px] rounded-full bg-blue-400/10 blur-[100px]"
		></div>

		<!-- linhas de luz -->
		<div class="absolute right-[-150px] top-[30%] h-[2px] w-[650px] rotate-[-19deg] bg-cyan-300/30"></div>
		<div class="absolute right-[-130px] top-[37%] h-[1px] w-[600px] rotate-[-19deg] bg-cyan-200/20"></div>
		<div class="absolute right-[-170px] top-[44%] h-[2px] w-[700px] rotate-[-19deg] bg-cyan-300/15"></div>

	</div>


	<!-- HEADER -->
	<div class="relative z-50">
		<Header />
	</div>


	<!-- CONTAINER -->
	<div class="relative mx-auto max-w-[1250px] px-3 sm:px-8 lg:px-10">


		<!-- ==================================================
		     HERO
		================================================== -->

		<div
			class="
				relative
				min-h-[300px]

				sm:min-h-[700px]

				lg:min-h-[650px]
			"
		>


			<!-- ==================================================
			     TEXTO PRINCIPAL
			================================================== -->

			<div
				class="
					relative
					z-30
					w-[62%]
					pt-8

					sm:w-[58%]
					sm:pt-12

					lg:w-[55%]
					lg:pt-14
				"
			>

				<p
					class="
						text-[8px]
						font-medium
						tracking-[0.25em]
						text-cyan-100
						uppercase

						sm:text-[13px]
					"
				>
					Internet que te conecta mais
				</p>


				<h1
					class="
						mt-2
						text-[36px]
						leading-[0.88]
						font-black
						tracking-[-0.055em]

						sm:text-[58px]

						lg:text-[70px]
					"
				>

					<span class="block text-white">
						INTERNET
					</span>


				</h1>
				<h1
					class="
						
						text-[22px]
						leading-[0.88]
						font-black
						tracking-[-0.055em]

						sm:text-[58px]

						lg:text-[70px]
					"
				>

					

					<span class="block text-cyan-300">
						NA VELOCIDADE
					</span>

		

				</h1>
				
				<h1
					class="
						
						text-[36px]
						leading-[0.88]
						font-black
						tracking-[-0.055em]

						sm:text-[58px]

						lg:text-[70px]
					"
				>

					<span class="block text-white">
						DA LUZ!
					</span>


				</h1>

				<p
					class="
						mt-5
						max-w-[310px]
						text-[14px]
						leading-[1.35]
						text-blue-50

						sm:max-w-[400px]
						sm:text-[18px]

						lg:text-[19px]
					"
				>
					Planos com
					<strong class="font-extrabold text-white">Disney+</strong>,
					<strong class="font-extrabold text-white">MAX</strong> <br>
					e muito mais para você <br> e sua família.
				</p>


				<!-- LOGOS -->
				<div
					class="
						mt-5
						flex
						items-center
						gap-4

						sm:mt-7
						sm:gap-8
					"
				>

					<Image
						src={disneyLogo}
						alt="Disney+"
						class="h-9 w-auto object-contain sm:h-10"
					/>

					<div class="h-9 w-px bg-white/30 sm:h-9"></div>

					<Image
						src={maxLogo}
						alt="MAX"
						class="h-9 w-auto object-contain brightness-0 invert sm:h-9"
					/>

				</div>

			</div>


			<!-- ==================================================
			     ASTRONAUTA
			================================================== -->

			<div
	class="
		pointer-events-none
		absolute
		right-[-9%]
		top-[20px]
		z-20
		h-[280px]
		w-[250px]

		sm:right-[-12%]
		sm:top-[115px]
		sm:h-[560px]
		sm:w-[590px]

		lg:right-[-7%]
		lg:top-[45px]
		lg:h-[680px]
		lg:w-[720px]
	"
>

	<!-- BRILHO ATRÁS DO ASTRONAUTA -->
	<div
		class="
			absolute
			left-[15%]
			top-[12%]
			h-[180px]
			w-[180px]
			rounded-full
			bg-cyan-300/20
			blur-[80px]

			sm:h-[350px]
			sm:w-[350px]
		"
	></div>

	<Image
		src={astronaut}
		alt="Astronauta NaveLinkNet"
		class="
			relative
			h-full
			w-full
			object-contain
			object-bottom
			drop-shadow-[0_20px_45px_rgba(0,0,0,0.4)]
			[mask-image:linear-gradient(to_bottom,black_85%,transparent_100%)]
			[-webkit-mask-image:linear-gradient(to_bottom,black_85%,transparent_100%)]
		"
		widths={[500, 700, 900]}
		sizes="(min-width: 1024px) 720px, 65vw"
	/>

</div>


			<!-- ==================================================
			     FRASE AO LADO DO ASTRONAUTA
			================================================== -->

			<div
				class="
					absolute
					right-[0%]
					top-[0px]
					z-30
					rotate-[-15deg]
		
					lg:right-[2%]
				"
			>

				<p
					class="
						font-serif
						text-[12px]
						leading-[1.3]
						text-white
						italic

						sm:text-[19px]

						lg:text-[21px]
					"
				>
					Conectar<br />
					pessoas<br />
					é o que<br />
					nos move!
				</p>

				

			</div>


			
			

		</div>


		<!-- ==================================================
		     PLANOS
		     3 COLUNAS NO MOBILE
		================================================== -->

		<div class="relative z-40 -mt-1 pb-4">

			<div
				class="
					grid
					grid-cols-3
					gap-2

					sm:gap-4
				"
			>

				{
					plans.map((plan) => (
						<div
							class:list={[
								'relative flex min-w-0 flex-col rounded-[15px] border px-2.5 pt-4 pb-3',
								'border-cyan-400/30 bg-[#063b9b]/95',
								'shadow-[0_10px_30px_rgba(0,0,0,0.25)]',

								plan.highlighted &&
									'border-2 border-cyan-300 shadow-[0_0_30px_rgba(0,220,255,0.5)] sm:-translate-y-4',
							]}
						>

							<!-- MAIS ESCOLHIDO -->
							{plan.highlighted && (
								<div
									class="
										absolute
										-top-3
										left-1/2
										flex
										-translate-x-1/2
										items-center
										gap-1
										rounded-full
										bg-cyan-300
										px-2
										py-1.5
										text-[7px]
										font-black
										whitespace-nowrap
										text-[#06337f]

										sm:px-4
										sm:text-[10px]
									"
								>

									<Icon
										name="lucide:crown"
										class="h-2.5 w-2.5 sm:h-3 sm:w-3"
									/>

									MAIS ESCOLHIDO

								</div>
							)}


							<!-- NOME -->
							<h2
								class="
									text-center
									text-[9px]
									font-black
									text-cyan-300

									sm:text-[16px]
								"
							>
								{plan.name}
							</h2>


							<!-- VELOCIDADE -->
							<div class="mt-1 text-center">

								<span
									class="
										text-[29px]
										leading-none
										font-black
										tracking-[-0.06em]
										text-white

										sm:text-[50px]
									"
								>
									{plan.speed}
								</span>

								{plan.unit && (
									<span
										class="
											block
											text-[8px]
											font-bold
											text-white

											sm:text-[14px]
										"
									>
										{plan.unit}
									</span>
								)}

							</div>


							<div
								class="
									my-2
									h-px
									bg-cyan-300/20

									sm:my-4
								"
							></div>


							<!-- BENEFÍCIOS -->
							<ul
								class="
									space-y-2

									sm:space-y-3
								"
							>

								{
									plan.features.map((feature) => (
										<li
											class="
												flex
												items-center
												gap-1.5
												text-[7px]
												leading-tight
												text-white/90

												sm:gap-2.5
												sm:text-[14px]
											"
										>

											<Icon
												name={feature.icon}
												class="
													h-3.5
													w-3.5
													shrink-0
													text-cyan-300

													sm:h-5
													sm:w-5
												"
											/>

											<span>
												{feature.label}
											</span>

										</li>
									))
								}

							</ul>


							<!-- PREÇO -->
							<div
								class="
									mt-3
									flex
									items-baseline
									justify-center
									whitespace-nowrap

									sm:mt-5
								"
							>

								<span
									class="
										text-[8px]
										font-bold

										sm:text-[15px]
									"
								>
									R$
								</span>

								<span
									class="
										ml-0.5
										text-[25px]
										leading-none
										font-black
										tracking-[-0.06em]

										sm:ml-1
										sm:text-[42px]
									"
								>
									{plan.price.split(',')[0]}
								</span>

								<sup
									class="
										text-[10px]
										font-black

										sm:text-[18px]
									"
								>
									,{plan.price.split(',')[1]}
								</sup>

							</div>


							<span
								class="
									mt-[-1px]
									text-center
									text-[7px]
									text-white/70

									sm:text-[11px]
								"
							>
								/mês
							</span>


							<!-- BOTÃO DO PLANO -->
							<a
								href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`Olá! Tenho interesse no ${plan.name}.`)}`}
								target="_blank"
								rel="noopener noreferrer"
								class="
									mt-2
									flex
									h-[22px]
									items-center
									justify-center
									gap-1
									rounded-full
									bg-[#16d957]
									text-[7px]
									font-medium
									text-white
									shadow-[0_4px_15px_rgba(0,255,100,0.25)]
									transition
									hover:brightness-110

									sm:mt-4
									sm:h-[40px]
									sm:gap-2
									sm:text-[13px]
								"
							>

								<Icon
									name="simple-icons:whatsapp"
									class="h-2.5 w-2.5 sm:h-5 sm:w-5"
								/>

								QUERO ESTE PLANO

							</a>

						</div>
					))
				}

			</div>

		</div>


		<!-- ==================================================
		     BENEFÍCIOS
		================================================== -->

		<div
			class="
				relative
				z-30
				py-4

				sm:py-10
			"
		>

			<div class="grid grid-cols-3">

				{
					featureStrip.map((item, index) => (
						<div
							class:list={[
								'flex flex-col items-center justify-center gap-1 px-1 text-center',
								index > 0 && 'border-l border-cyan-300/30',
								'sm:flex-row sm:gap-3 sm:text-left',
							]}
						>

							<Icon
								name={item.icon}
								class="
									h-7
									w-7
									shrink-0
									text-cyan-300

									sm:h-9
									sm:w-9
								"
							/>

							<div class="leading-tight">

								<p
									class="
										text-[8px]
										font-medium
										text-white/90

										sm:text-[15px]
									"
								>
									{item.title}
								</p>

								<p
									class="
										text-[8px]
										text-white/90

										sm:text-[15px]
									"
								>
									{item.text}
								</p>

							</div>

						</div>
					))
				}

			</div>

		</div>


		


		<!-- SEGURANÇA -->
		<p
			class="
				relative
				z-30
				flex
				items-center
				justify-center
				gap-1.5
				pb-7
				text-[10px]
				text-white/80

				sm:gap-2
				sm:pb-8
				sm:text-[13px]
			"
		>

			<Icon
				name="lucide:lock-keyhole"
				class="h-3.5 w-3.5 sm:h-4 sm:w-4"
			/>

			Seus dados estão seguros conosco.

		</p>

	</div>


	

</section>