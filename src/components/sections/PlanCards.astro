---
import { Icon } from 'astro-icon/components';

const whatsappNumber = '5500000000000';

const plans = [
	{
		name: 'COMBO START',
		speed: '300',
		unit: 'MEGA',
		features: [
			{ icon: 'lucide:wifi', label: 'Wi-Fi incluso' },
			{ icon: 'lucide:monitor-play', label: '2 apps de streaming' },
			{ icon: 'lucide:users-round', label: 'Ideal para o dia a dia' },
		],
		price: '79,90',
	},
	{
		name: 'COMBO FULL',
		speed: '850',
		unit: 'MEGA',
		features: [
			{ icon: 'lucide:wifi', label: 'Wi-Fi incluso' },
			{ icon: 'lucide:monitor-play', label: '3 apps de streaming' },
			{ icon: 'lucide:users-round', label: 'Ideal para famílias' },
		],
		price: '139,80',
		highlighted: true,
	},
	{
		name: 'COMBO VIP',
		speed: '1 GIGA',
		unit: '',
		features: [
			{ icon: 'lucide:wifi', label: 'Wi-Fi incluso' },
			{ icon: 'lucide:monitor-play', label: '4 apps de streaming' },
			{ icon: 'lucide:users-round', label: 'Máxima performance' },
		],
		price: '169,90',
	},
];
---

<!-- ==================================================
     PLANOS
     3 COLUNAS NO MOBILE
================================================== -->
<div class="relative z-40 -mt-1 pb-4">
	<div
		class="grid
			grid-cols-3
			gap-1
			sm:gap-3
			md:gap-4
			lg:gap-5"
	>
		{plans.map((plan) => (
			<div
				class:list={[
					'relative flex min-w-0 flex-col rounded-[15px] border px-2.5 pt-4 pb-3',
					'sm:rounded-[18px] sm:px-4 sm:pt-5 sm:pb-4',
					'md:rounded-[20px] md:px-5 md:pt-6 md:pb-5',
					'lg:px-6 lg:pt-7 lg:pb-6',
					'border-cyan-400/30 bg-[#063b9b]/95',
					'shadow-[0_10px_30px_rgba(0,0,0,0.25)]',

					plan.highlighted &&
						'card-glow z-10 border-2 border-cyan-300 sm:-translate-y-4',
				]}
			>
				<!-- MAIS ESCOLHIDO -->
				{plan.highlighted && (
					<div
						class="absolute
						-top-3
						left-1/2
						flex
						-translate-x-1/2
						items-center
						gap-1
						rounded-full
						bg-cyan-300
						px-2
						py-1
						text-[6px]
						font-black
						whitespace-nowrap
						text-[#06337f]
						sm:px-3
						sm:py-1.5
						sm:text-[9px]
						md:px-4
						md:text-[10px]
						lg:gap-1.5
						lg:px-4
						lg:py-1.5
						lg:text-[11px]
						xl:text-[12px]"
					>
						<Icon
							name="lucide:crown"
							class="h-2
							w-2
							sm:h-3
							sm:w-3
							lg:h-3.5
							lg:w-3.5"
						/>
						MAIS ESCOLHIDO
					</div>
				)}

				<!-- NOME -->
				<h2
					class="text-center
					text-[9px]
					font-black
					text-cyan-300
					sm:text-[14px]
					md:text-[16px]
					lg:text-[18px]"
				>
					{plan.name}
				</h2>

				<!-- VELOCIDADE -->
				<div class="mt-1 text-center">
					<span
						class="text-[29px]
						leading-none
						font-black
						tracking-[-0.06em]
						text-white
						sm:text-[40px]
						md:text-[50px]
						lg:text-[58px]"
					>
						{plan.speed}
					</span>

					{plan.unit && (
						<span
							class="block
							text-[8px]
							font-bold
							text-white
							sm:text-[12px]
							md:text-[14px]
							lg:text-[16px]"
						>
							{plan.unit}
						</span>
					)}
				</div>

				<div
					class="my-2
					h-px
					bg-cyan-300/20
					sm:my-3
					md:my-4
					lg:my-5"
				/>

				<!-- BENEFÍCIOS -->
				<ul
					class="space-y-2
					sm:space-y-2.5
					md:space-y-3
					lg:space-y-3.5"
				>
					{plan.features.map((feature) => (
						<li
							class="flex
								items-center
								gap-1.5
								text-[7px]
								leading-tight
								text-white/90
								sm:gap-2
								md:gap-2.5
								md:text-[14px]
								lg:text-[15px]"
						>
							<Icon
								name={feature.icon}
								class="h-3.5
									w-3.5
									shrink-0
									text-cyan-300
									sm:h-4
									sm:w-4
									md:h-5
									md:w-5
									lg:h-5
									lg:w-5"
							/>

							<span>{feature.label}</span>
						</li>
					))}
				</ul>

				<!-- PREÇO + BOTÃO (fixado no rodapé do card) -->
				<div
					class="mt-auto
					pt-3
					sm:pt-4
					md:pt-5
					lg:pt-6"
				>
					<!-- PREÇO -->
					<div
						class="flex
						items-baseline
						justify-center
						whitespace-nowrap"
					>
						<span
							class="text-[8px]
							font-bold
							sm:text-[12px]
							md:text-[15px]
							lg:text-[17px]"
						>
							R$
						</span>

						<span
							class="ml-0.5
							text-[25px]
							leading-none
							font-black
							tracking-[-0.06em]
							sm:ml-1
							sm:text-[34px]
							md:text-[42px]
							lg:text-[48px]"
						>
							{plan.price.split(',')[0]}
						</span>

						<sup
							class="text-[10px]
							font-black
							sm:text-[14px]
							md:text-[18px]
							lg:text-[20px]"
						>
							,{plan.price.split(',')[1]}
						</sup>
					</div>

					<span
						class="mt-[-1px]
						block
						text-center
						text-[7px]
						text-white/70
						sm:text-[9px]
						md:text-[11px]
						lg:text-[12px]"
					>
						/mês
					</span>

					<!-- BOTÃO DO PLANO -->
					<a
						href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`Olá! Tenho interesse no ${plan.name}.`)}`}
						target="_blank"
						rel="noopener noreferrer"
						class="mt-2
						flex
						h-[22px]
						items-center
						justify-center
						gap-1
						rounded-full
						bg-[#16d957]
						text-[7px]
						font-medium
						text-white
						shadow-[0_4px_15px_rgba(0,255,100,0.25)]
						transition
						hover:brightness-110
						sm:mt-3
						sm:h-[32px]
						sm:gap-1.5
						sm:text-[10px]
						md:mt-4
						md:h-[40px]
						md:gap-2
						md:text-[13px]
						lg:h-[46px]
						lg:text-[14px]"
					>
						<Icon
							name="simple-icons:whatsapp"
							class="h-2.5
							w-2.5
							sm:h-3.5
							sm:w-3.5
							md:h-5
							md:w-5"
						/>
						QUERO ESTE PLANO
					</a>
				</div>
			</div>
		))}
	</div>
</div>

<style>
	.card-glow {
		box-shadow:
			0 0 10px rgba(0, 220, 255, 0.75),
			0 0 18px rgba(0, 220, 255, 0.55),
			0 10px 30px rgba(0, 0, 0, 0.25);
	}
</style>
