---
import { Icon } from 'astro-icon/components';

const whatsappNumber = '5500000000000';

const featureIcons = [
	{ label: 'Filmes\ne séries', icon: 'lucide:clapperboard' },
	{ label: 'Esportes\nao vivo', icon: 'lucide:goal' },
	{ label: 'Programação\ninfantil', icon: 'lucide:baby', underline: 'infantil' },
	{ label: 'Canais\nde variedades', icon: 'lucide:tv-minimal' },
];

const channels = [
	{ name: 'PREMIERE', variant: 'premiere' },
	{ name: 'NOSSO FUTEBOL', variant: 'futebol' },
	{ name: 'COMBATE', variant: 'combate' },
	{ name: 'TELECINE', variant: 'telecine' },
	{ name: 'CINEMAX', variant: 'cinemax' },
	{ name: 'UNIVERSAL TV', variant: 'universal' },
	{ name: 'STAR', variant: 'star' },
	{ name: 'MEGA KIDS', variant: 'megakids' },
];

const combos = [
	{ name: 'PREMIERE', variant: 'premiere', price: '59,90' },
	{ name: 'NOSSO FUTEBOL', variant: 'futebol', price: '19,90' },
	{ name: 'COMBATE', variant: 'combate', price: '34,90' },
	{ name: 'TELECINE', variant: 'telecine', price: '29,90' },
];
---

<section class="relative overflow-hidden bg-linear-to-b from-white via-sky-50 to-sky-100 px-6 py-14">
	<div class="pointer-events-none absolute -top-10 right-0 h-72 w-72 rounded-full bg-sky-300/30 blur-3xl"></div>

	<div class="relative mx-auto max-w-6xl">
		<div class="grid items-center gap-10 lg:grid-cols-2">
			<div>
				<span class="inline-block rounded-full bg-sky-100 px-4 py-1.5 text-xs font-bold tracking-[0.15em] text-sky-700 uppercase">
					TV por assinatura
				</span>

				<h2 class="mt-4 text-4xl leading-[1.1] font-black text-[#0a1657] sm:text-5xl">
					Turbine seu<br />
					plano com<br />
					<span class="text-sky-500">SKY + FULL</span>
				</h2>

				<p class="mt-5 max-w-md text-base text-slate-600">
					Mais de 90 canais com milhares de filmes, séries, esportes e muito mais para toda a família.
				</p>

				<div class="mt-8 grid grid-cols-4 gap-3 text-center">
					{
						featureIcons.map((item) => (
							<div class="flex flex-col items-center gap-2">
								<span class="flex h-14 w-14 items-center justify-center rounded-full bg-sky-100 text-sky-500">
									<Icon name={item.icon} class="h-6 w-6" />
								</span>
								<p class="text-xs font-semibold whitespace-pre-line text-slate-700">
									{item.underline
										? item.label.split(item.underline).map((part, i, arr) => (
												<>
													{part}
													{i < arr.length - 1 && <span class="underline">{item.underline}</span>}
												</>
											))
										: item.label}
								</p>
							</div>
						))
					}
				</div>
			</div>

			<div class="relative flex justify-center py-6">
				<p class="absolute -top-4 right-2 hidden -rotate-6 font-serif text-lg text-sky-600 italic sm:block">
					Mais<br />entretenimento<br />para o seu dia!
				</p>

				<div class="relative">
					<div class="pointer-events-none absolute -inset-6 rounded-full bg-sky-300/30 blur-2xl"></div>

					<div class="relative w-72 rounded-xl bg-slate-900 p-3 shadow-2xl sm:w-80">
						<div class="rounded-md bg-linear-to-br from-[#0a1657] to-[#12237a] px-4 py-8">
							<p class="text-center text-3xl font-black text-white">
								SKY<span class="text-red-500">+</span>
							</p>
							<div class="mt-6 flex justify-center gap-2">
								<span class="flex h-9 w-9 items-center justify-center rounded-md bg-red-500 text-white">
									<Icon name="lucide:play" class="h-4 w-4" />
								</span>
								<span class="flex h-9 w-9 items-center justify-center rounded-md bg-white text-slate-700">
									<Icon name="lucide:goal" class="h-4 w-4" />
								</span>
								<span class="flex h-9 w-9 items-center justify-center rounded-md bg-sky-500 text-white">
									<Icon name="lucide:clapperboard" class="h-4 w-4" />
								</span>
								<span class="flex h-9 w-9 items-center justify-center rounded-md bg-violet-500 text-white">
									<Icon name="lucide:baby" class="h-4 w-4" />
								</span>
								<span class="flex h-9 w-9 items-center justify-center rounded-md bg-teal-500 text-white">
									<Icon name="lucide:leaf" class="h-4 w-4" />
								</span>
							</div>
						</div>
					</div>
					<div class="mx-auto h-3 w-20 rounded-b-md bg-slate-800"></div>
					<div class="mx-auto h-2 w-32 rounded-full bg-slate-900/70"></div>

					<div class="absolute -right-8 -bottom-4 flex h-40 w-14 -rotate-6 flex-col items-center gap-2 rounded-2xl bg-slate-900 py-3 shadow-xl sm:-right-10">
						<span class="h-4 w-4 rounded-full bg-red-500"></span>
						<span class="mt-1 h-6 w-6 rounded-full border-2 border-slate-600"></span>
						<span class="h-2 w-8 rounded-full bg-slate-700"></span>
						<span class="h-2 w-8 rounded-full bg-slate-700"></span>
						<span class="h-2 w-8 rounded-full bg-slate-700"></span>
					</div>
				</div>
			</div>
		</div>

		<div class="mt-10 rounded-3xl border border-sky-100 bg-white p-6 shadow-sm sm:p-8">
			<p class="text-center text-sm font-black tracking-wide text-sky-600 uppercase sm:text-base">
				Mais de 90 canais com milhares de filmes e séries
			</p>

			<div class="mt-6 grid grid-cols-2 divide-x divide-y divide-slate-100 border-t border-l border-slate-100 sm:grid-cols-4">
				{
					channels.map((channel) => (
						<div class="flex items-center justify-center p-5">
							{channel.variant === 'premiere' && (
								<span class="rounded-md border-2 border-green-600 px-3 py-1 text-xs font-black tracking-wide text-green-600">
									PREMIERE
								</span>
							)}
							{channel.variant === 'futebol' && (
								<span class="text-center leading-none">
									<span class="block text-[10px] font-semibold tracking-wide text-slate-500">NOSSO</span>
									<span class="block border-b-2 border-lime-500 pb-0.5 text-lg font-black text-[#0a1657]">FUTEBOL</span>
								</span>
							)}
							{channel.variant === 'combate' && (
								<span class="text-lg font-black text-red-600 italic">COMBATE</span>
							)}
							{channel.variant === 'telecine' && (
								<span class="text-lg font-black">
									<span class="text-slate-900">TELE</span><span class="text-sky-500">CINE</span>
								</span>
							)}
							{channel.variant === 'cinemax' && (
								<span class="flex items-center gap-1 text-base font-black text-[#0a1657]">
									<span class="flex h-5 w-5 items-center justify-center rounded-full border-2 border-[#0a1657] text-[10px]">C</span>
									CINEMAX
								</span>
							)}
							{channel.variant === 'universal' && (
								<span class="flex flex-col items-center">
									<span class="flex h-9 w-9 items-center justify-center rounded-full border-2 border-slate-400 text-[8px] font-bold text-slate-500">
										UNIV.
									</span>
									<span class="mt-1 text-[10px] font-bold text-slate-500">TV</span>
								</span>
							)}
							{channel.variant === 'star' && (
								<span class="flex items-center text-xl font-black text-[#0a1657]">
									ST
									<Icon name="lucide:star" class="mx-0.5 h-4 w-4 text-violet-500" />
									R
								</span>
							)}
							{channel.variant === 'megakids' && (
								<span class="text-lg font-black">
									<span class="text-[#0a1657]">MEGA</span> <span class="text-orange-500">KIDS</span>
								</span>
							)}
						</div>
					))
				}
			</div>
		</div>

		<p class="mt-10 text-center text-xl font-bold text-[#0a1657]">Seu combo ainda mais completo com:</p>

		<div class="mt-6 grid gap-4 sm:grid-cols-2">
			{
				combos.map((combo) => (
					<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
						<div
							class:list={[
								'flex h-16 items-center justify-center',
								combo.variant === 'premiere' && 'bg-green-600',
								combo.variant === 'combate' && 'bg-[#0a1657]',
								(combo.variant === 'futebol' || combo.variant === 'telecine') && 'bg-white border-b border-slate-100',
							]}
						>
							{combo.variant === 'premiere' && (
								<span class="rounded-md border-2 border-white px-3 py-1 text-xs font-black tracking-wide text-white">
									PREMIERE
								</span>
							)}
							{combo.variant === 'futebol' && (
								<span class="text-center leading-none">
									<span class="block text-[10px] font-semibold tracking-wide text-slate-500">NOSSO</span>
									<span class="block border-b-2 border-lime-500 pb-0.5 text-lg font-black text-[#0a1657]">FUTEBOL</span>
								</span>
							)}
							{combo.variant === 'combate' && <span class="text-lg font-black text-red-500 italic">COMBATE</span>}
							{combo.variant === 'telecine' && (
								<span class="text-lg font-black">
									<span class="text-slate-900">TELE</span><span class="text-sky-500">CINE</span>
								</span>
							)}
						</div>

						<div class="p-5">
							<p class="text-3xl font-black text-[#0a1657]">
								R$ {combo.price.split(',')[0]}
								<span class="text-lg">,{combo.price.split(',')[1]}</span>
								<span class="text-sm font-normal text-slate-500">/mês</span>
							</p>

							<a
								href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`Olá! Tenho interesse no combo ${combo.name}.`)}`}
								target="_blank"
								rel="noopener noreferrer"
								class="mt-4 flex items-center justify-center gap-2 rounded-full border-2 border-sky-500 py-2.5 text-sm font-bold text-sky-600 transition hover:bg-sky-50"
							>
								<Icon name="simple-icons:whatsapp" class="h-4 w-4" />
								QUERO ESTE COMBO
								<Icon name="lucide:chevron-right" class="h-4 w-4" />
							</a>
						</div>
					</div>
				))
			}
		</div>

		<p class="mt-6 text-center text-[11px] leading-snug text-slate-500">
			*Consulte disponibilidade de canais e planos. **Para adquirir os canais<br />
			à la carte é necessário obter a SKY+ Full.
		</p>

		<a
			href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Olá! Quero contratar o SKY + Full.')}`}
			target="_blank"
			rel="noopener noreferrer"
			class="mt-6 flex items-center justify-center gap-3 rounded-full bg-green-500 py-5 text-lg font-extrabold text-white transition hover:bg-green-400"
		>
			<Icon name="simple-icons:whatsapp" class="h-6 w-6" />
			CONTRATE PELO WHATSAPP
			<Icon name="lucide:chevron-right" class="h-5 w-5" />
		</a>
	</div>
</section>
