---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import tv from '../../assets/tv.webp';
import premiereLogo from '../../assets/logos/premiere-logo.png';
import futebolLogo from '../../assets/logos/nosso-futebol.png';
import combateLogo from '../../assets/logos/combate.png';
import telecineLogo from '../../assets/logos/telecine.png';
import universalLogo from '../../assets/logos/universal-tv-logo.png';
import starLogo from '../../assets/logos/Star_logo.svg.webp';

const whatsappNumber = '5500000000000';

const featureIcons = [
	{ label: 'Filmes\ne séries', icon: 'lucide:clapperboard' },
	{ label: 'Esportes\nao vivo', icon: 'lucide:goal' },
	{
		label: 'Programação\ninfantil',
		icon: 'lucide:baby',
		underline: 'infantil',
	},
	{ label: 'Canais\nde variedades', icon: 'lucide:tv-minimal' },
];

const channels = [
	{ name: 'PREMIERE', variant: 'premiere' },
	{ name: 'NOSSO FUTEBOL', variant: 'futebol' },
	{ name: 'COMBATE', variant: 'combate' },
	{ name: 'TELECINE', variant: 'telecine' },
	{ name: 'CINEMAX', variant: 'cinemax' },
	{ name: 'UNIVERSAL TV', variant: 'universal' },
	{ name: 'STAR', variant: 'star' },
	{ name: 'MEGA KIDS', variant: 'megakids' },
];

const combos = [
	{ name: 'PREMIERE', variant: 'premiere', price: '59,90' },
	{ name: 'NOSSO FUTEBOL', variant: 'futebol', price: '19,90' },
	{ name: 'COMBATE', variant: 'combate', price: '34,90' },
	{ name: 'TELECINE', variant: 'telecine', price: '29,90' },
];
---

<section class="relative overflow-hidden bg-linear-to-b from-white via-sky-50 to-sky-100 px-4 py-10 sm:px-6 sm:py-14 lg:py-20">
	<div class="pointer-events-none absolute -top-10 right-0 h-48 w-48 rounded-full bg-sky-300/30 blur-3xl sm:h-72 sm:w-72"></div>

	<div class="relative mx-auto max-w-6xl">
		<!-- ==================================================
		     TOPO: TEXTO + TV FLUTUANTE
		================================================== -->
		<div
			class="relative
				min-h-[210px]
				sm:min-h-[420px]
				lg:min-h-[480px]"
		>
			<!-- TEXTO -->
			<div class="relative z-30 w-[62%] sm:w-[58%] lg:w-[55%]">
				<span class="inline-block rounded-full bg-sky-200 px-3 py-1 text-[10px] font-bold text-sky-700 uppercase sm:px-4 sm:py-1.5 sm:text-xs">
					TV por assinatura
				</span>

				<h2
					class="mt-2
						text-[31px]
						leading-[0.88]
						font-black
						tracking-[-0.03em]
						sm:text-[58px]
						lg:text-[70px]
						xl:text-[78px]"
				>
					<span class="block text-[#0a1657]">
						Turbine seu <br />
						plano com
						<br />
					</span>
				</h2>
				<h2
					class="mt-1.5
						text-[36px]
						leading-[0.88]
						font-black
						tracking-[-0.03em]
						sm:text-[58px]
						lg:text-[70px]
						xl:text-[78px]"
				>
					<span class="block text-sky-500">SKY+FULL</span>
				</h2>

				<p class="mt-3 text-[14px] leading-[1.2] text-slate-600 sm:mt-5 sm:text-base lg:text-lg">
					Mais de 90 canais com milhares <br /> de filmes, séries, esportes e{' '}
					<br /> muito mais para toda a família.
				</p>
			</div>

			<!-- ==================================================
			     TV FLUTUANTE (mesmo tratamento do astronauta)
			================================================== -->
			<div
				class="pointer-events-none
					absolute
					right-[-10%]
					top-[0px]
					z-20
					h-[180px]
					w-[215px]
					sm:right-[-8%]
					sm:top-[0px]
					sm:h-[380px]
					sm:w-[420px]
					lg:right-[-4%]
					lg:top-[-20px]
					lg:h-[460px]
					lg:w-[500px]"
			>
				<!-- FRASE MANUSCRITA -->
				<p
					class="absolute
						-top-2
						right-2
						hidden
						-rotate-6
						font-serif
						text-lg
						text-sky-600
						italic
						sm:block"
				>
					Mais
					<br />
					entretenimento
					<br />
					para o seu dia!
				</p>

				<Image
					src={tv}
					alt="Smart TV exibindo o menu SKY+ com controle remoto"
					class="relative
						h-full
						w-full
						object-contain
						object-bottom"
					widths={[400, 600, 800]}
					sizes="(min-width: 1024px) 500px, 60vw"
				/>
			</div>
		</div>

		<!-- ÍCONES DE FEATURES (agora em linha cheia, abaixo do bloco topo) -->
		<div class="relative z-30 grid grid-cols-4 gap-3 text-center sm:mt-8 sm:grid-cols-4 lg:gap-5">
			{featureIcons.map((item) => (
				<div class="flex flex-col items-center gap-2">
					<span class="flex h-10 w-10 items-center justify-center rounded-full bg-sky-100 text-sky-500 sm:h-14 sm:w-14 lg:h-16 lg:w-16">
						<Icon
							name={item.icon}
							class="h-5 w-5 sm:h-6 sm:w-6 lg:h-7 lg:w-7"
						/>
					</span>
					<p class="text-[10px] font-medium whitespace-pre-line text-slate-600 sm:text-xs lg:text-sm">
						{item.underline
							? item.label.split(item.underline).map((part, i, arr) => (
									<>
										{part}
										{i < arr.length - 1 && (
											<span class="underline">{item.underline}</span>
										)}
									</>
								))
							: item.label}
					</p>
				</div>
			))}
		</div>

		<!-- BLOCO: TÍTULO + CARD DAS LOGOS -->
		<div class="relative mt-6 sm:mt-12">
			<!-- TÍTULO (fica atrás, só a borda de baixo é coberta) -->
			<div class="relative z-0 mx-auto w-fit rounded-2xl bg-white px-5 pt-2 pb-5.5 shadow-sm sm:rounded-3xl sm:px-8 sm:pt-4 sm:pb-8">
				<p class="text-center text-[10px] font-bold tracking-wide text-sky-600 uppercase sm:text-sm lg:text-base">
					Mais de 90 canais com milhares de filmes e séries
				</p>
			</div>

			<!-- CARD DAS LOGOS  -->
			<div class="relative z-10 -mt-4 rounded-2xl border border-sky-100 bg-white p-2 shadow-sm sm:-mt-5 sm:rounded-3xl sm:p-4 lg:p-6">
				<div class="grid grid-cols-4 divide-x divide-y divide-slate-100 sm:grid-cols-4">
					{channels.map((channel) => (
						<div class="flex items-center justify-center p-3 sm:p-5 lg:p-7">
							{channel.variant === 'premiere' && (
								<Image
									src={premiereLogo}
									alt="Premiere"
									class="h-6 w-auto object-contain sm:h-7 lg:h-8"
								/>
							)}
							{channel.variant === 'futebol' && (
								<Image
									src={futebolLogo}
									alt="Nosso Futebol"
									class="h-10 w-auto object-contain sm:h-14 lg:h-16"
								/>
							)}
							{channel.variant === 'combate' && (
								<Image
									src={combateLogo}
									alt="Combate"
									class="h-5 w-auto object-contain sm:h-6 lg:h-7"
								/>
							)}
							{channel.variant === 'telecine' && (
								<span class="rounded-md bg-[#0a1657] px-2 py-1.5 sm:px-3 sm:py-2">
									<Image
										src={telecineLogo}
										alt="Telecine"
										class="h-3 w-auto object-contain sm:h-4 lg:h-5"
									/>
								</span>
							)}
							{channel.variant === 'cinemax' && (
								<span class="flex items-center gap-1 text-xs font-black text-[#0a1657] sm:text-base lg:text-lg">
									<span class="flex h-4 w-4 items-center justify-center rounded-full border-2 border-[#0a1657] text-[8px] sm:h-5 sm:w-5 sm:text-[10px] lg:h-6 lg:w-6 lg:text-xs">
										C
									</span>
									CINEMAX
								</span>
							)}
							{channel.variant === 'universal' && (
								<Image
									src={universalLogo}
									alt="Universal TV"
									class="h-9 w-auto object-contain sm:h-12 lg:h-14"
								/>
							)}
							{channel.variant === 'star' && (
								<Image
									src={starLogo}
									alt="Star"
									class="h-4 w-auto object-contain sm:h-6 lg:h-7"
								/>
							)}
							{channel.variant === 'megakids' && (
								<span class="text-sm font-black sm:text-lg lg:text-xl">
									<span class="text-[#0a1657]">MEGA</span>{' '}
									<span class="text-orange-500">KIDS</span>
								</span>
							)}
						</div>
					))}
				</div>
			</div>
		</div>

		<p class="mt-6 text-center text-lg font-bold text-[#0a1657] sm:mt-10 sm:text-xl lg:text-2xl">
			Seu combo ainda mais completo com:
		</p>

		<div class="mt-4 grid grid-cols-2 gap-2.5 sm:mt-6 sm:gap-4 lg:grid-cols-4">
			{combos.map((combo) => (
				<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm sm:rounded-3xl">
					<!-- CABEÇALHO: flush, sem respiro, cantos de cima arredondados pelo overflow-hidden do pai -->
					<div
						class:list={[
							'flex h-14 items-center justify-center sm:h-20',
							combo.variant === 'premiere' && 'bg-[#328C2E]',
							combo.variant === 'combate' && 'bg-[#0a1657]',
							combo.variant === 'futebol' && 'bg-[#fdfdff]',
							combo.variant === 'telecine' && 'bg-[#020518]',
						]}
					>
						{combo.variant === 'premiere' && (
							<Image
								src={premiereLogo}
								alt="Premiere"
								class="h-5 w-auto object-contain sm:h-7"
							/>
						)}
						{combo.variant === 'futebol' && (
							<Image
								src={futebolLogo}
								alt="Nosso Futebol"
								class="h-12 w-auto object-contain sm:h-12"
							/>
						)}
						{combo.variant === 'combate' && (
							<Image
								src={combateLogo}
								alt="Combate"
								class="h-4 w-auto object-contain sm:h-7"
							/>
						)}
						{combo.variant === 'telecine' && (
							<Image
								src={telecineLogo}
								alt="Telecine"
								class="h-4 w-auto object-contain sm:h-5"
							/>
						)}
					</div>

					<!-- CONTEÚDO: sobe por cima do cabeçalho, criando o corte curvo -->
					<div class="relative -mt-3 rounded-t-2xl bg-white p-2 sm:-mt-4.5 sm:rounded-t-3xl sm:p-5">
						<p class="flex items-baseline justify-center gap-0.5">
							<span class="text-sm font-bold text-[#0a1657] sm:text-lg">
								R$
							</span>

							<span class="text-[42px] leading-none font-black tracking-tight text-[#0a1657] sm:text-[56px]">
								{combo.price.split(',')[0]}
							</span>

							<span class="flex flex-col items-start">
								<span class="text-base font-black text-[#0a1657] sm:text-xl">
									,{combo.price.split(',')[1]}
								</span>
								<span class="text-[10px] font-normal text-slate-500 sm:text-xs">
									/mês
								</span>
							</span>
						</p>
						<a
							href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`Olá! Tenho interesse no combo ${combo.name}.`)}`}
							target="_blank"
							rel="noopener noreferrer"
							class="mt-2
						flex
						h-[28px]
						items-center
						justify-center
						gap-1
						rounded-full
						border
						border-sky-500
						bg-white
						text-[8px]
						font-bold
						text-sky-600
						transition
						hover:bg-sky-50
						sm:mt-3
						sm:h-[38px]
						sm:gap-1.5
						sm:text-[11px]
						md:mt-4
						md:h-[44px]
						md:gap-2
						md:text-[13px]"
						>
							<span class="flex h-4 w-4 items-center justify-center rounded-full sm:h-5 sm:w-5">
								<Icon
									name="simple-icons:whatsapp"
									class="h-2.5 w-2.5 sm:h-3 sm:w-3"
								/>
							</span>
							QUERO ESTE COMBO
							<Icon name="lucide:chevron-right" class="h-3 w-3 sm:h-4 sm:w-4" />
						</a>
					</div>
				</div>
			))}
		</div>

		<p class="mt-6 text-center text-[11px] leading-snug text-slate-500 sm:text-[11px]">
			*Consulte disponibilidade de canais e planos. **Para adquirir os canais
			<br />à la carte é necessário obter a SKY+ Full.
		</p>
	</div>
</section>
